        "import hashlib\n",
        "\n",
        "# Function to calculate SHA-256 hash of a file\n",
        "def calculate_hash(filename):\n",
        "    sha256 = hashlib.sha256()\n",
        "\n",
        "    with open(filename, \"rb\") as file:\n",
        "        while True:\n",
        "            data = file.read(4096)\n",
        "            if not data:\n",
        "                break\n",
        "            sha256.update(data)\n",
        "\n",
        "    return sha256.hexdigest()\n",
        "\n",
        "\n",
        "# Specify the evidence file\n",
        "filename = \"evidence.txt\"\n",
        "\n",
        "try:\n",
        "    # Initial hash (record when evidence is collected)\n",
        "    original_hash = calculate_hash(filename)\n",
        "    print(\"Original SHA-256 Hash:\")\n",
        "    print(original_hash)\n",
        "\n",
        "    input(\"\\nPress Enter to verify the file later...\")\n",
        "\n",
        "    # Recalculate hash during verification\n",
        "    current_hash = calculate_hash(filename)\n",
        "    print(\"\\nCurrent SHA-256 Hash:\")\n",
        "    print(current_hash)\n",
        "\n",
        "    # Verify integrity\n",
        "    if original_hash == current_hash:\n",
        "        print(\"\\nVerification Successful\")\n",
        "        print(\"The evidence file has not been altered.\")\n",
        "        print(\"Hash values match, supporting the chain of custody.\")\n",
        "    else:\n",
        "        print(\"\\nVerification Failed\")\n",
        "        print(\"The evidence file has been modified.\")\n",
        "        print(\"Hash values do not match.\")\n",
        "\n",
        "except FileNotFoundError:\n",
        "    print(f\"Error: '{filename}' not found.\")"
      ]
    }
